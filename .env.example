# Copy this file to .env and replace every placeholder before deployment.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ROOT_PASSWORD
DB_NAME=loan_management
DB_USER=loan_app
DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=1h
SEED_ON_BOOT=false
FRONTEND_PORT=80

# Public address of the web app, used inside reset/settlement links sent by email.
WEB_PUBLIC_URL=http://localhost

# Notifications: transport is log (dev, prints to server log), kafka (docker compose) or http (direct to mailer).
# docker-compose always runs the backend with kafka; set log here for local `npm run dev:server`.
NOTIFY_ENABLED=true
NOTIFY_TRANSPORT=log
NOTIFY_DEFAULT_LOCALE=lo
NOTIFY_POLL_INTERVAL_MS=5000
NOTIFY_BATCH_SIZE=20
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BACKOFF_SECONDS=30
# Key that seals the notification outbox bodies (OTP and reset links are encrypted with it).
# Rotating it leaves previously stored, still-undelivered secrets unreadable on purpose.
NOTIFY_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SEALING_KEY

# Only needed when NOTIFY_TRANSPORT=kafka (or when running the mailer consumer locally).
KAFKA_BROKERS=127.0.0.1:9094
KAFKA_HOST_PORT=9094
KAFKA_TOPIC=loan.notification
KAFKA_DLQ_TOPIC=loan.notification.dlq

# Shared secret between backend and mailer (both directions).
MAILER_API_KEY=REPLACE_WITH_A_LONG_RANDOM_MAILER_KEY
MAILER_BASE_URL=http://127.0.0.1:4100

# SMTP for the mailer. Leave SMTP_HOST empty to run without a mail provider:
# messages are then rendered and logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Loan Management System <no-reply@loanms.local>
MAILER_SEND_ATTEMPTS=3

# Password rules. These are the defaults; ADMIN can change them at runtime through
# Admin -> System configuration, which stores the values in system_config (password.* keys).
PASSWORD_MIN_LENGTH=6
PASSWORD_MAX_LENGTH=16
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_SYMBOL=false

# Staff avatars: images only, size capped, and the feature can be switched off entirely.
AVATAR_ENABLED=true
AVATAR_MAX_FILE_SIZE_KB=512
AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Repayment collection: staff may only settle instalments that have arrived, so early money is
# booked as customer credit and this job settles it from that credit. The switch stays off until an
# ADMIN turns it on (Admin -> System configuration), which overrides these defaults at runtime
# through system_config (payment.* keys).
AUTO_DEBIT_ENABLED=false
AUTO_DEBIT_LEAD_DAYS=3
AUTO_DEBIT_POLL_INTERVAL_MS=900000

# Collateral: how much pledged value must cover of what is still owed, and how long an appraisal
# stays believable. A hardship addendum (restructure) is refused when coverage fails or every
# appraisal is out of date. ADMIN can change these at runtime through
# Admin -> System configuration, which stores the values in system_config (collateral.* keys).
COLLATERAL_MIN_COVERAGE_PERCENT=100
COLLATERAL_MAX_VALUATION_AGE_DAYS=365
COLLATERAL_REQUIRE_PLEDGE_FOR_RESTRUCTURE=true

# Forgot-password timings (secrets are stored hashed and are single-use).
RESET_OTP_TTL_MINUTES=10
RESET_OTP_MAX_ATTEMPTS=5
RESET_LINK_TTL_MINUTES=60
RESET_REQUEST_COOLDOWN_SECONDS=60

# Account security: when the system locks an account by itself and when a password must be
# replaced. Every value can be overridden at runtime through Admin -> System configuration,
# which stores the values in system_config (security.* keys). 0 switches that one rule off.
# A locked account is unlocked by an ADMIN only; unlocking emails a link to set a new password.
ACCOUNT_MAX_FAILED_ATTEMPTS=3
ACCOUNT_IDLE_LOCK_DAYS=90
# Off by default: a failed sign-in applies the idle rule immediately, the job only pre-marks
# idle accounts in the database before anyone tries to sign in.
ACCOUNT_IDLE_LOCK_JOB_ENABLED=false
ACCOUNT_IDLE_LOCK_POLL_HOURS=24
PASSWORD_MAX_AGE_DAYS=30
PASSWORD_EXPIRY_WARN_DAYS=7
# How many previous passwords a new one may not repeat. 0 = only the current password.
PASSWORD_HISTORY_COUNT=5
SECURITY_APPLY_TO_ADMIN_ACCOUNTS=true

# ---------------------------------------------------------------------------
# Bank dev estate - docker-dev-compose.yaml. The lms-mysql / lms-backend / lms-mailer /
# lms-frontend services read the SAME keys as above, plus the three ports below, because that
# file already publishes 80 and 3306 for other services.
# Kafka is the estate broker, so those services use the hardcoded in-network address
# kafka:19092 (their INTERNAL listener) and ignore KAFKA_BROKERS / KAFKA_HOST_PORT above.
# While testing, leave SMTP_HOST empty: the mailer renders and logs the message and never calls
# a real mail provider.
# ---------------------------------------------------------------------------
LMS_MYSQL_HOST_PORT=3309
LMS_BACKEND_HOST_PORT=4001
LMS_FRONTEND_HOST_PORT=8098
# Do not add a second WEB_PUBLIC_URL line for this file: dotenv keeps only the last one, and the
# two compose files need different values. Left unset, docker-compose.yml uses http://localhost
# (Kong/nginx on port 80) and docker-dev-compose.yaml uses http://localhost:8098, which is the port
# this file publishes the app on. Set it only when users really reach the app through that port.

# ---------------------------------------------------------------------------
# Production stack only - docker-compose.prod.yml. The dev file ignores all of this.
# The two one-shot services (db-migrate, kong-migrations) run as part of `up -d` and need no setup.
# ---------------------------------------------------------------------------

# Kong is the only container with a published port. 8001 is mapped to 127.0.0.1 so the gateway
# scripts can reach the Admin API from the host, and nothing else can.
KONG_VERSION=3.6
KONG_HTTP_PORT=80
# Keep 8443 until a real certificate is installed, then switch this to 443.
KONG_HTTPS_PORT=8443
KONG_ADMIN_PORT=8001
KONG_LOG_LEVEL=notice

# Kong's own Postgres. It is never published to the host; this password only has to be strong
# because a compromised gateway would otherwise reach it.
KONG_PG_DB=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_KONG_DATABASE_PASSWORD

# Gateway objects and plugins created by scripts/gateway/bootstrap.sh.
# Every KONG_* line in this file is picked up by those scripts.
KONG_RATE_LIMIT_SECOND=20
KONG_RATE_LIMIT_MINUTE=600
KONG_MAX_REQUEST_SIZE_KB=10240
# Leave false: the app is served from the same origin as the API, and server/src/app.ts already
# sends Access-Control-Allow-Origin, so enabling this duplicates the header and breaks browsers.
KONG_ENABLE_CORS=false
KONG_CORS_ORIGINS=

# Resource ceilings, applied by docker compose without Swarm. Each service follows the same
# pattern: <NAME>_CPUS and <NAME>_MEMORY for backend, frontend, mailer, mysql, kafka, zookeeper,
# kong, kong-postgres (e.g. MYSQL_MEMORY=1536m, BACKEND_CPUS=2.0).
# These are starting points for a small branch, not tuned numbers.
BACKEND_MEMORY=1g
MYSQL_MEMORY=1536m
KAFKA_MEMORY=1280m
KONG_MEMORY=1g

# Log rotation per container, so an hourly winston file or a chatty broker cannot fill the disk.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# Container image tag, so a release is traceable: IMAGE_TAG=v1.0.0
IMAGE_TAG=prod
