# Server
PORT=4000
NODE_ENV=development

# Database (MySQL via docker-compose, host port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=loanpass
DB_NAME=loan_management

# Auth
JWT_SECRET=change-me-in-production-8f3b1c9d2e7a4f60
JWT_EXPIRES_IN=12h

# Seed admin bootstrap (used on first boot only)
SEED_ON_BOOT=true

# Seals the notification outbox bodies (they can carry an OTP or a reset link). Set a fresh
# 32+ character value per environment; rotating it makes previously stored bodies unreadable.
NOTIFY_SECRET_KEY=change-me-in-production-notify-sealing-key
